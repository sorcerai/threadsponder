# =============================================================================
# Threadsponder Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# =============================================================================

# --- Required ---

# Supabase (database + file storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Upstash Redis (job queue)
# TCP URL for BullMQ workers
UPSTASH_REDIS_URL=redis://default:your-password@your-endpoint.upstash.io:6379
# REST URL for API package
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# OpenRouter (AI classification + response generation)
OPENROUTER_API_KEY=sk-or-v1-...

# Encryption key for Threads API tokens (generate: openssl rand -base64 32)
CREDENTIAL_ENCRYPTION_KEY=your-32-byte-base64-key

# --- App config ---

PORT=3008
NODE_ENV=development
DEFAULT_ORG_ID=default
DASHBOARD_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:3008

# --- Threads credentials (paste your token here) ---
# The system auto-seeds these into the database on first startup.
# Get a token via the Meta Developer Console or OAuth flow.

THREADS_ACCESS_TOKEN=your-threads-access-token
THREADS_USER_ID=your-threads-user-id
# THREADS_USERNAME=your-username

# --- Threads OAuth (alternative — if you want to use the browser flow) ---
# THREADS_APP_ID=your-meta-app-id
# THREADS_APP_SECRET=your-meta-app-secret
# THREADS_REDIRECT_URI=http://localhost:3008/api/auth/threads/callback

# --- Optional ---

# Z.AI fast classifier (GLM-4.7 — faster than OpenRouter for classification)
# Z_AI_API_KEY=...

# Resend email notifications
# RESEND_API_KEY=re_...
# FROM_EMAIL=noreply@yourdomain.com

