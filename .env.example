# Supabase (database, auth, storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Upstash Redis (for BullMQ)
UPSTASH_REDIS_URL=redis://default:your-password@your-endpoint.upstash.io:6379

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# OpenRouter (for AI responses)
OPENROUTER_API_KEY=sk-or-v1-...

# Stripe (billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_TRIAL=price_...
STRIPE_PRICE_ID_MONTHLY=price_...

# Encryption key for storing Threads tokens (32 bytes, base64)
TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key

# API
PORT=3001
